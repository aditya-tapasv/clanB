# Copy to .env.local for local development. On Vercel, add these under Project → Settings → Environment Variables.

# Canonical site URL (sitemap, robots, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://clanb.in

# NestJS backend base URL (global prefix /api). Used once the "Real API" blocks in lib/api are switched on.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# ── Auth (server-only: never prefix these with NEXT_PUBLIC_) ───────────────────
# Signs the httpOnly session cookie. REQUIRED in production, 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Mock mode only (until the NestJS AuthModule is live):
# e-mails that log in as admin, and e-mails/phones (+91XXXXXXXXXX) that log in as vendor.
ADMIN_EMAILS=admin@clanb.in
VENDOR_IDENTIFIERS=vendor@clanb.in
# The OTP every mock login accepts.
MOCK_OTP_CODE=123456
